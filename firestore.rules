rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: services
    // Fields: name (string), category (string), duration (number), price (number), description (string)
    //
    // Collection: professionals
    // Fields: name (string), specialties (list of strings)
    //
    // Collection: appointments
    // Fields: serviceId (string), professionalId (string), date (string), time (string), clientName (string), clientEmail (string), clientPhone (string), status (string), notes (string), createdAt (string)
    //
    // Collection: promotions
    // Fields: title (string), description (string), discount (string), active (bool)
    //
    // Collection: users
    // Fields: email (string), role (string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "nahuelvalquinta2@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidService(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.category in ["Pestañas y cejas", "Uñas", "Masajes y bienestar", "Cosmetología", "Podología", "Tratamientos corporales"] &&
             data.duration is number && data.duration > 0;
    }

    function isValidAppointment(data) {
      return data.serviceId is string &&
             data.date is string &&
             data.time is string &&
             data.clientName is string && data.clientName.size() > 0 &&
             data.clientPhone is string && data.clientPhone.size() > 0 &&
             data.status in ["pending", "approved", "cancelled"];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin();
      allow create: if isValidAppointment(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
